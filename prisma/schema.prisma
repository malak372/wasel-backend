/**
 * Prisma Schema
 * -------------
 * Project: Wasel Backend
 * Author: All Team Members
 *
 * This Prisma schema defines the database structure for the Wasel system.
 * It models the core entities, enums, and relationships required to support
 * authentication, checkpoint tracking, incident reporting, citizen reports,
 * alert subscriptions, route storage, moderation workflows, and audit history.
 *
 * Responsibilities:
 * - Define the PostgreSQL datasource connection
 * - Configure the Prisma client generator
 * - Declare all application enums used across the system
 * - Define database models, fields, relations, indexes, and constraints
 * - Map Prisma model fields to database table and column names
 *
 * Main Functional Areas:
 * - User authentication and refresh token management
 * - Regional hierarchy and geographic organization
 * - Checkpoint management and checkpoint status history
 * - Incident creation, verification, closure, and status history
 * - Citizen reporting, duplicate tracking, and voting
 * - Moderation and audit trail recording
 * - Alert subscriptions and alert delivery records
 * - Route persistence and metadata storage
 * - External API request logging
 *
 * Design Goals:
 * - Maintain clear entity relationships across all modules
 * - Support auditability through history and moderation tables
 * - Preserve normalized database design where appropriate
 * - Improve query performance using indexes on frequently filtered fields
 * - Keep database naming consistent using explicit @map and @@map mappings
 *
 * Notes:
 * - PostgreSQL is used as the primary database provider
 * - UUIDs are used as primary keys for most entities
 * - Enums are used to enforce valid system states and classifications
 * - Timestamps are included across major entities for tracking and auditing
 */

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * Enums
 * -----
 * These enums define the fixed set of values used across the system.
 *
 * Purpose:
 * - Restrict invalid values at the database level
 * - Keep application logic and database states consistent
 * - Simplify validation and filtering in backend services
 */

enum UserRole {
  citizen
  moderator
  admin
}

enum CheckpointStatus {
  open
  delayed
  closed
  unknown
}

enum IncidentSeverity {
  low
  medium
  high
  critical
}

enum IncidentStatus {
  open
  verified
  closed
  rejected
}

enum IncidentSourceType {
  official
  crowd
  external_api
}

enum ReportStatus {
  pending
  approved
  rejected
  merged
}

enum VoteType {
  confirm
  deny
}

enum ModerationTargetType {
  report
  incident
}

enum ModerationActionType {
  approve
  reject
  verify
  close
  merge
  flag
}

enum RegionType {
  city
  village
  governorate
  area
}

enum AlertDeliveryStatus {
  pending
  sent
  failed
}

/**
 * User
 * ----
 * Represents a system user account.
 *
 * Supports:
 * - Authentication and authorization
 * - Role-based access control
 * - Report submission
 * - Incident reporting and verification
 * - Route creation
 * - Alert subscription ownership
 *
 * Roles:
 * - citizen
 * - moderator
 * - admin
 */
model User {
  id                      String                    @id @default(uuid())
  fullName                String                    @map("full_name")
  email                   String                    @unique
  passwordHash            String                    @map("password_hash")
  role                    UserRole
  isActive                Boolean                   @default(true) @map("is_active")
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  alertSubscriptions      AlertSubscription[]
  checkpointStatusChanges CheckpointStatusHistory[]
  citizenReports          CitizenReport[]
  incidentStatusChanges   IncidentStatusHistory[]
  closedIncidents         Incident[]                @relation("IncidentClosedBy")
  reportedIncidents       Incident[]                @relation("IncidentReportedBy")
  verifiedIncidents       Incident[]                @relation("IncidentVerifiedBy")
  moderationActions       ModerationAction[]        @relation("ModeratorActions")
  refreshTokens           RefreshToken[]
  reportVotes             ReportVote[]
  routes                  Route[]

  @@map("users")
}

/**
 * Region
 * ------
 * Represents a geographic area in the system.
 *
 * Purpose:
 * - Organize checkpoints, incidents, reports, and subscriptions
 * - Support hierarchical region structure using parent-child relations
 *
 * Examples:
 * - Governorate
 * - City
 * - Village
 * - Area
 */
model Region {
  id                 String              @id @default(uuid())
  name               String
  parentRegionId     String?             @map("parent_region_id")
  regionType         RegionType          @map("region_type")
  alertSubscriptions AlertSubscription[]
  checkpoints        Checkpoint[]
  citizenReports     CitizenReport[]
  incidents          Incident[]
  parentRegion       Region?             @relation("RegionHierarchy", fields: [parentRegionId], references: [id])
  childRegions       Region[]            @relation("RegionHierarchy")

  @@index([parentRegionId])
  @@index([name])
  @@map("regions")
}

/**
 * Checkpoint
 * ----------
 * Represents a physical checkpoint location tracked by the system.
 *
 * Stores:
 * - Name and coordinates
 * - Assigned region
 * - Current operational status
 * - Related incidents
 * - Status history records
 */
model Checkpoint {
  id            String                    @id @default(uuid())
  name          String
  latitude      Decimal                   @db.Decimal(9, 6)
  longitude     Decimal                   @db.Decimal(9, 6)
  regionId      String                    @map("region_id")
  description   String?
  currentStatus CheckpointStatus          @default(unknown) @map("current_status")
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")
  statusHistory CheckpointStatusHistory[]
  region        Region                    @relation(fields: [regionId], references: [id])
  incidents     Incident[]

  @@index([regionId])
  @@index([currentStatus])
  @@index([name])
  @@map("checkpoints")
}

/**
 * CheckpointStatusHistory
 * -----------------------
 * Stores historical changes for checkpoint statuses.
 *
 * Purpose:
 * - Track how checkpoint status changes over time
 * - Record who made the change when available
 * - Support auditing and timeline analysis
 */
model CheckpointStatusHistory {
  id              String           @id @default(uuid())
  checkpointId    String           @map("checkpoint_id")
  status          CheckpointStatus
  changedByUserId String?          @map("changed_by_user_id")
  note            String?
  changedAt       DateTime         @default(now()) @map("changed_at")
  changedByUser   User?            @relation(fields: [changedByUserId], references: [id])
  checkpoint      Checkpoint       @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  @@index([checkpointId])
  @@index([changedByUserId])
  @@index([changedAt])
  @@map("checkpoint_status_history")
}

/**
 * IncidentCategory
 * ----------------
 * Defines supported incident classification types.
 *
 * Examples:
 * - closure
 * - delay
 * - accident
 * - weather_hazard
 * - military_activity
 * - road_damage
 */
model IncidentCategory {
  id                 String              @id @default(uuid())
  name               String              @unique
  description        String?
  alertSubscriptions AlertSubscription[]
  citizenReports     CitizenReport[]
  incidents          Incident[]

  @@map("incident_categories")
}

/**
 * Incident
 * --------
 * Represents a road, checkpoint, or mobility-related incident.
 *
 * Stores:
 * - Title and description
 * - Category, severity, and status
 * - Source type
 * - Optional checkpoint and region linkage
 * - Geographic coordinates
 * - Reporting, verification, and closure metadata
 *
 * Purpose:
 * - Track real-world events affecting mobility
 * - Support moderation and lifecycle transitions
 */
model Incident {
  id               String                  @id @default(uuid())
  title            String
  description      String?
  categoryId       String                  @map("category_id")
  severity         IncidentSeverity
  status           IncidentStatus          @default(open)
  sourceType       IncidentSourceType      @map("source_type")
  checkpointId     String?                 @map("checkpoint_id")
  regionId         String?                 @map("region_id")
  latitude         Decimal?                @db.Decimal(9, 6)
  longitude        Decimal?                @db.Decimal(9, 6)
  reportedByUserId String?                 @map("reported_by_user_id")
  verifiedByUserId String?                 @map("verified_by_user_id")
  closedByUserId   String?                 @map("closed_by_user_id")
  occurredAt       DateTime                @map("occurred_at")
  verifiedAt       DateTime?               @map("verified_at")
  closedAt         DateTime?               @map("closed_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  alerts           Alert[]
  citizenReports   CitizenReport[]
  statusHistory    IncidentStatusHistory[]
  category         IncidentCategory        @relation(fields: [categoryId], references: [id])
  checkpoint       Checkpoint?             @relation(fields: [checkpointId], references: [id])
  closedByUser     User?                   @relation("IncidentClosedBy", fields: [closedByUserId], references: [id])
  region           Region?                 @relation(fields: [regionId], references: [id])
  reportedByUser   User?                   @relation("IncidentReportedBy", fields: [reportedByUserId], references: [id])
  verifiedByUser   User?                   @relation("IncidentVerifiedBy", fields: [verifiedByUserId], references: [id])

  @@index([categoryId])
  @@index([checkpointId])
  @@index([regionId])
  @@index([status])
  @@index([severity])
  @@index([sourceType])
  @@index([occurredAt])
  @@index([reportedByUserId])
  @@index([verifiedByUserId])
  @@index([closedByUserId])
  @@map("incidents")
}

/**
 * IncidentStatusHistory
 * ---------------------
 * Stores lifecycle transitions for incidents.
 *
 * Purpose:
 * - Preserve audit trail of incident status changes
 * - Record old and new status values
 * - Track change reason and responsible user
 */
model IncidentStatusHistory {
  id              String         @id @default(uuid())
  incidentId      String         @map("incident_id")
  oldStatus       IncidentStatus @map("old_status")
  newStatus       IncidentStatus @map("new_status")
  changedByUserId String?        @map("changed_by_user_id")
  reason          String?
  changedAt       DateTime       @default(now()) @map("changed_at")
  changedByUser   User?          @relation(fields: [changedByUserId], references: [id])
  incident        Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([changedByUserId])
  @@index([changedAt])
  @@map("incident_status_history")
}

/**
 * CitizenReport
 * -------------
 * Represents a report submitted by a citizen about a road or traffic issue.
 *
 * Stores:
 * - Reporter information
 * - Category and optional linked incident
 * - Description and coordinates
 * - Region, report time, and moderation status
 * - Duplicate linkage and confidence score
 *
 * Purpose:
 * - Support crowd-sourced reporting
 * - Enable moderation, merging, and validation workflows
 */
model CitizenReport {
  id                  String           @id @default(uuid())
  userId              String?          @map("user_id")
  categoryId          String           @map("category_id")
  incidentId          String?          @map("incident_id")
  description         String
  latitude            Decimal?         @db.Decimal(9, 6)
  longitude           Decimal?         @db.Decimal(9, 6)
  regionId            String?          @map("region_id")
  reportTime          DateTime         @map("report_time")
  status              ReportStatus     @default(pending)
  duplicateOfReportId String?          @map("duplicate_of_report_id")
  confidenceScore     Decimal?         @map("confidence_score") @db.Decimal(5, 2)
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  category            IncidentCategory @relation(fields: [categoryId], references: [id])
  duplicateOfReport   CitizenReport?   @relation("DuplicateReports", fields: [duplicateOfReportId], references: [id])
  duplicateReports    CitizenReport[]  @relation("DuplicateReports")
  incident            Incident?        @relation(fields: [incidentId], references: [id])
  region              Region?          @relation(fields: [regionId], references: [id])
  user                User?            @relation(fields: [userId], references: [id])
  votes               ReportVote[]

  @@index([userId])
  @@index([categoryId])
  @@index([incidentId])
  @@index([regionId])
  @@index([status])
  @@index([reportTime])
  @@index([duplicateOfReportId])
  @@map("citizen_reports")
}

/**
 * ReportVote
 * ----------
 * Represents a citizen vote on a submitted report.
 *
 * Purpose:
 * - Support report confirmation or denial
 * - Help estimate confidence and credibility of crowd reports
 *
 * Constraint:
 * - A user can vote only once per report
 */
model ReportVote {
  id        String        @id @default(uuid())
  reportId  String        @map("report_id")
  userId    String        @map("user_id")
  voteType  VoteType      @map("vote_type")
  createdAt DateTime      @default(now()) @map("created_at")
  report    CitizenReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reportId, userId])
  @@index([userId])
  @@map("report_votes")
}

/**
 * ModerationAction
 * ----------------
 * Represents an action performed by a moderator on a target entity.
 *
 * Targets:
 * - report
 * - incident
 *
 * Actions:
 * - approve
 * - reject
 * - verify
 * - close
 * - merge
 * - flag
 *
 * Purpose:
 * - Maintain moderation audit history
 */
model ModerationAction {
  id              String               @id @default(uuid())
  targetType      ModerationTargetType @map("target_type")
  targetId        String               @map("target_id")
  moderatorUserId String               @map("moderator_user_id")
  actionType      ModerationActionType @map("action_type")
  reason          String?
  createdAt       DateTime             @default(now()) @map("created_at")
  moderatorUser   User                 @relation("ModeratorActions", fields: [moderatorUserId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([moderatorUserId])
  @@index([actionType])
  @@map("moderation_actions")
}

/**
 * AlertSubscription
 * -----------------
 * Represents a user's alert preference.
 *
 * Purpose:
 * - Allow users to subscribe to incident notifications
 * - Filter alerts by region and category
 * - Track whether the subscription is active
 */
model AlertSubscription {
  id         String            @id @default(uuid())
  userId     String            @map("user_id")
  regionId   String?           @map("region_id")
  categoryId String?           @map("category_id")
  isActive   Boolean           @default(true) @map("is_active")
  createdAt  DateTime          @default(now()) @map("created_at")
  category   IncidentCategory? @relation(fields: [categoryId], references: [id])
  region     Region?           @relation(fields: [regionId], references: [id])
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts     Alert[]

  @@unique([userId, regionId, categoryId])
  @@index([userId])
  @@index([regionId])
  @@index([categoryId])
  @@index([isActive])
  @@map("alert_subscriptions")
}

/**
 * Alert
 * -----
 * Represents a generated alert linked to an incident and a subscription.
 *
 * Stores:
 * - Alert message
 * - Delivery status
 * - Creation and send timestamps
 *
 * Purpose:
 * - Track alert generation and delivery workflow
 */
model Alert {
  id             String              @id @default(uuid())
  incidentId     String              @map("incident_id")
  subscriptionId String              @map("subscription_id")
  alertMessage   String              @map("alert_message")
  deliveryStatus AlertDeliveryStatus @default(pending) @map("delivery_status")
  createdAt      DateTime            @default(now()) @map("created_at")
  sentAt         DateTime?           @map("sent_at")
  incident       Incident            @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  subscription   AlertSubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([subscriptionId])
  @@index([deliveryStatus])
  @@map("alerts")
}

/**
 * Route
 * -----
 * Represents a saved route estimation request or result.
 *
 * Stores:
 * - Origin and destination names and coordinates
 * - Estimated distance and duration
 * - Avoidance preferences
 * - Route metadata
 * - Creator reference
 *
 * Purpose:
 * - Persist route calculations for later retrieval and analysis
 */
model Route {
  id                   String   @id @default(uuid())
  originName           String   @map("origin_name")
  originLat            Decimal  @map("origin_lat") @db.Decimal(9, 6)
  originLng            Decimal  @map("origin_lng") @db.Decimal(9, 6)
  destinationName      String   @map("destination_name")
  destinationLat       Decimal  @map("destination_lat") @db.Decimal(9, 6)
  destinationLng       Decimal  @map("destination_lng") @db.Decimal(9, 6)
  estimatedDistanceKm  Decimal? @map("estimated_distance_km") @db.Decimal(10, 2)
  estimatedDurationMin Int?     @map("estimated_duration_min")
  avoidCheckpoints     Json?    @map("avoid_checkpoints")
  avoidAreas           Json?    @map("avoid_areas")
  metadataJson         Json?    @map("metadata_json")
  createdByUserId      String?  @map("created_by_user_id")
  createdAt            DateTime @default(now()) @map("created_at")
  createdByUser        User?    @relation(fields: [createdByUserId], references: [id])

  @@index([createdByUserId])
  @@map("routes")
}

/**
 * ExternalApiLog
 * --------------
 * Stores logs for third-party API requests made by the system.
 *
 * Examples:
 * - Routing API requests
 * - Weather API requests
 *
 * Purpose:
 * - Support monitoring, debugging, and integration auditing
 */
model ExternalApiLog {
  id             String   @id @default(uuid())
  providerName   String   @map("provider_name")
  endpoint       String
  requestSummary String?  @map("request_summary")
  responseStatus Int?     @map("response_status")
  responseTimeMs Int?     @map("response_time_ms")
  cached         Boolean  @default(false)
  errorMessage   String?  @map("error_message")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([providerName])
  @@index([createdAt])
  @@map("external_api_logs")
}

/**
 * RefreshToken
 * ------------
 * Stores hashed refresh tokens for authenticated users.
 *
 * Purpose:
 * - Support secure token refresh workflow
 * - Track token expiration and revocation
 * - Improve session management security
 */
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}